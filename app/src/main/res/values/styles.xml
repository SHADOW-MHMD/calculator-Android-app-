<resources>
    <style name="Calc.BaseButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">18sp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:padding">0dp</item>
    </style>

    <style name="Calc.NumberButton" parent="Calc.BaseButton">
        <item name="backgroundTint">@color/key_number</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="Calc.FunctionButton" parent="Calc.BaseButton">
        <item name="backgroundTint">@color/key_function</item>
        <item name="android:textColor">@color/key_function_text</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Calc.OperatorButton" parent="Calc.BaseButton">
        <item name="backgroundTint">@color/key_operator</item>
        <item name="android:textColor">@color/key_operator_text</item>
    </style>

    <style name="Calc.EqualsButton" parent="Calc.BaseButton">
        <item name="backgroundTint">@color/key_equals</item>
        <item name="android:textColor">@color/key_equals_text</item>
        <item name="android:textSize">26sp</item>
    </style>
</resources>
